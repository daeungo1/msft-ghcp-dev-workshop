{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/com.github.copilot/hooks/pre_tool_guard.py\"",
        "powershell": "python \"$env:PLUGIN_ROOT\\com.github.copilot\\hooks\\pre_tool_guard.py\"",
        "cwd": ".",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/com.github.copilot/hooks/post_edit_check.py\"",
        "powershell": "python \"$env:PLUGIN_ROOT\\com.github.copilot\\hooks\\post_edit_check.py\"",
        "cwd": ".",
        "timeoutSec": 150
      }
    ]
  }
}
